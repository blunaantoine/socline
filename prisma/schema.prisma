// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  // Driver adapters let PrismaClient run on remote libSQL/Turso databases
  // (used for the Vercel demo deployment — see VERCEL_DEPLOY.md). Local dev
  // keeps the plain SQLite file via DATABASE_URL.
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User roles enum
enum UserRole {
  CLIENT
  WASHER
  ADMIN
}

// Washer type enum - Two types of washers
enum WasherType {
  INDEPENDENT   // Laveur indépendant - travaille avec les tarifs de l'app
  STATION_OWNER // Propriétaire de station - crée ses propres offres/tarifs
}

// Service source enum - Who created the service
enum ServiceSource {
  APP       // Service créé par l'app (pour laveurs indépendants)
  STATION   // Service créé par une station de lavage
}

// Address type enum
enum AddressType {
  HOME
  WORK
  OTHER
}

// Order status enum
enum OrderStatus {
  PENDING       // Waiting for washer
  ACCEPTED      // Washer accepted
  EN_ROUTE      // Washer on the way
  ARRIVED       // Washer arrived
  IN_PROGRESS   // Wash in progress
  COMPLETED     // Wash completed
  CANCELLED     // Order cancelled
}

// Payment status enum
enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Payment method enum
enum PaymentMethod {
  WALLET
  CASH
}

// Wallet transaction type enum
enum TransactionType {
  DEPOSIT       // Rechargement
  WITHDRAWAL    // Retrait
  PAYMENT       // Paiement de commande
  REFUND        // Remboursement
  BONUS         // Bonus/Promotion
}

// Wallet transaction status enum
enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

// Promotion type enum
enum PromotionType {
  GLOBAL
  TARGETED
  PROMO_CODE
}

// Main User model
model User {
  id            String    @id @default(cuid())
  phone         String    @unique
  email         String?
  name          String?
  avatar        String?
  role          UserRole  @default(CLIENT)
  isActive      Boolean   @default(true)
  
  // Client specific fields (for car identification)
  plateNumber   String?   // Numéro de plaque (deprecated - use Car model)
  carColor      String?   // Couleur de la voiture (deprecated - use Car model)
  pin           String?   // 4-digit PIN code
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  clientOrders  Order[]   @relation("ClientOrders")
  washer        Washer?
  reviews       Review[]
  payments      Payment[]
  notifications Notification[]
  sentMessages  Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  wallet        Wallet?
  cars          Car[]     // User's cars (max 10)
  clientFavorites Favorite[] @relation("ClientFavorites") // Washers marked as favorite
  subscriptions UserSubscription[] // User's subscriptions
  addresses     Address[] // User's saved addresses
  stations      Station[] @relation("StationOwner") // Stations owned by this user (if station owner)

  @@map("users")
}

// Address model (saved user addresses)
model Address {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Address details
  label         String      // e.g., "Maison", "Boulot", "Chez maman"
  type          AddressType @default(HOME)
  address       String      // Full address
  latitude      Float?
  longitude     Float?

  // Additional info
  instructions  String?     // Delivery instructions
  isDefault     Boolean     @default(false)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("addresses")
}

// Car model (for client vehicles)
model Car {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Car details
  nickname      String?  // e.g., "Ma Clio", "Voiture de travail"
  plateNumber   String   // Numéro de plaque (e.g., TG-1234-A)
  brand         String?  // Marque (e.g., Renault, Toyota)
  model         String?  // Modèle (e.g., Clio, Corolla)
  color         String   // Couleur (e.g., Blanc, Noir, Bleu)
  
  // Additional info
  year          Int?     // Année du véhicule
  
  // Photo of the vehicle — helps the washer recognize the car on arrival
  photo         String?
  
  // Default car for orders
  isDefault     Boolean  @default(false)
  
  // Orders booked for this vehicle
  orders        Order[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("cars")
}

// Washer model (extends User)
model Washer {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Washer type - INDEPENDENT or STATION_OWNER
  washerType     WasherType @default(INDEPENDENT)
  
  // Washer specific fields
  isAvailable    Boolean  @default(false)
  isVerified     Boolean  @default(false)
  rating         Float    @default(0)
  totalRatings   Int      @default(0)
  totalEarnings  Float    @default(0)
  completedJobs  Int      @default(0)
  
  // Location
  latitude       Float?
  longitude      Float?
  address        String?
  
  // Documents
  idDocument     String?
  vehiclePlate   String?
  vehicleModel   String?
  
  // Bank info for payments
  bankName       String?
  bankAccount    String?
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  orders         Order[]
  withdrawals    WasherWithdrawal[]
  withdrawalNumbers WasherWithdrawalNumber[]
  favorites      Favorite[] @relation("WasherFavorites") // Clients who favorited this washer
  stationId      String?
  station        Station? @relation(fields: [stationId], references: [id])

  @@map("washers")
}

// Trusted withdrawal numbers (numéros de retrait de confiance).
// The washer registers up to MAX 3 numbers at setup (self-confirmed); only
// the ADMIN can add/remove afterwards, following a washer request.
model WasherWithdrawalNumber {
  id          String   @id @default(cuid())
  washerId    String
  washer      Washer   @relation(fields: [washerId], references: [id], onDelete: Cascade)

  // Togo national 8-digit format (e.g. "90123456") — always displayed +228.
  phoneNumber String
  operator    String?  // "Mixx by Yas" | "Flooz" — default operator for this number
  label       String?  // e.g. "Numéro principal"

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([washerId, phoneNumber])
  @@map("washer_withdrawal_numbers")
}

// Station model
model Station {
  id          String   @id @default(cuid())
  name        String
  description String?
  address     String
  latitude    Float?
  longitude   Float?
  phone       String?
  email       String?
  images      String?  // JSON array of image URLs
  rating      Float    @default(0)
  totalRatings Int     @default(0)
  isActive    Boolean  @default(true)
  
  // Owner relationship - the station owner (washer with type STATION_OWNER)
  ownerId     String?  // User ID of the station owner
  owner       User?    @relation("StationOwner", fields: [ownerId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  washers     Washer[]
  services    Service[]
  orders      Order[]

  @@map("stations")
}

// Service model (types of wash services)
model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  duration    Int      // Duration in minutes
  image       String?
  category    String   // e.g., "basic", "premium", "deluxe"
  products    String?  // JSON array of products used
  isActive    Boolean  @default(true)
  
  // Coverage of the wash — makes the difference explicit for clients & washers:
  // EXTERIOR = outside only (carrosserie) | FULL = complete wash (extérieur + intérieur)
  coverage    String   @default("FULL")
  
  // Service source - APP (for independent washers) or STATION (custom station services)
  source      ServiceSource @default(APP)
  
  stationId   String?
  station     Station? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  orders            Order[]
  subscriptionPlans SubscriptionPlan[] // Plans associated with this service

  @@map("services")
}

// Subscription usage status enum
enum SubscriptionUsageStatus {
  PENDING     // Created but not yet validated
  VALIDATED   // Validated by washer
  CANCELLED   // Cancelled before validation
}

// Order model
model Order {
  id              String       @id @default(cuid())
  orderNumber     String       @unique
  
  // Client info
  clientId        String
  client          User         @relation("ClientOrders", fields: [clientId], references: [id])
  
  // Washer info
  washerId        String?
  washer          Washer?      @relation(fields: [washerId], references: [id], onDelete: SetNull)
  
  // Service info
  serviceId       String
  service         Service      @relation(fields: [serviceId], references: [id])
  
  // Station info (for station wash)
  stationId       String?
  station         Station?     @relation(fields: [stationId], references: [id], onDelete: SetNull)
  
  // Order type
  isHomeService   Boolean      @default(true)  // true = home, false = station
  
  // Location
  address         String
  latitude        Float?
  longitude       Float?
  
  // Vehicle being washed — lets the washer recognize the client's car
  carId           String?
  car             Car?     @relation(fields: [carId], references: [id], onDelete: SetNull)
  
  // Verification photos taken by the washer (data URLs, downscaled client-side):
  // BEFORE = car condition when the washer arrives, AFTER = result once done.
  // Used by the client and the admin to verify the service.
  beforePhotoUrl  String?
  afterPhotoUrl   String?
  
  // Pricing
  basePrice       Float
  discount        Float        @default(0)
  promoCode       String?
  totalPrice      Float
  commission      Float        @default(0)  // Platform commission
  
  // Subscription usage (if order uses subscription)
  subscriptionId       String?
  isSubscriptionOrder  Boolean      @default(false)  // True if this order uses a subscription session
  subscriptionValidated    Boolean      @default(false)  // True once washer validates the session
  subscriptionValidatedAt  DateTime?
  
  // Status
  status          OrderStatus  @default(PENDING)
  
  // Scheduling
  scheduledAt     DateTime?    // For scheduled orders
  estimatedArrival DateTime?   // Estimated arrival time
  
  // Timestamps
  acceptedAt      DateTime?
  startedAt       DateTime?    // When washer starts journey
  arrivedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  payment         Payment?
  review          Review?
  tracking        TrackingEvent[]
  conversation    Conversation?
  subscriptionUsage  SubscriptionUsage?

  @@map("orders")
}

// Favorite washers — a client can bookmark a washer to find/recognize him
// easily after a good experience (one favorite per client×washer pair).
model Favorite {
  id        String   @id @default(cuid())
  clientId  String
  client    User     @relation("ClientFavorites", fields: [clientId], references: [id], onDelete: Cascade)
  washerId  String
  washer    Washer   @relation("WasherFavorites", fields: [washerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([clientId, washerId])
  @@map("favorites")
}

// Payment model
model Payment {
  id              String        @id @default(cuid())
  orderId         String        @unique
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  
  amount          Float
  method          PaymentMethod @default(CASH)
  status          PaymentStatus @default(PENDING)
  
  // Transaction details
  transactionId   String?       // External transaction ID
  phoneNumber     String?       // For mobile money
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("payments")
}

// Review model
model Review {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  clientId    String
  client      User     @relation(fields: [clientId], references: [id])
  
  washerId    String?
  stationId   String?
  
  rating      Int      // 1-5
  comment     String?
  
  // Photos before/after
  beforePhotos String? // JSON array
  afterPhotos  String? // JSON array
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("reviews")
}

// Tracking events for real-time order tracking
model TrackingEvent {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  event       String   // e.g., "WASHER_ACCEPTED", "WASHER_EN_ROUTE", "WASHER_ARRIVED"
  latitude    Float?
  longitude   Float?
  message     String?
  
  createdAt   DateTime @default(now())

  @@map("tracking_events")
}

// Promotion model
model Promotion {
  id              String         @id @default(cuid())
  name            String
  description     String?
  type            PromotionType  @default(GLOBAL)
  
  // Discount value
  discountType    String         @default("PERCENTAGE") // PERCENTAGE or FIXED
  discountValue   Float
  
  // Promo code (if type is PROMO_CODE)
  code            String?        @unique
  
  // Display options
  displayType     String         @default("TEXT") // TEXT or IMAGE
  image           String?        // URL or base64 of the promotional image (only if displayType is IMAGE)
  imagePosition   String         @default("center") // CSS object-position values: "center", "top", "bottom", "50% 30%", etc.
  
  // Validity
  startDate       DateTime
  endDate         DateTime
  
  // Usage limits
  maxUses         Int?
  currentUses     Int            @default(0)
  maxUsesPerUser  Int            @default(1)
  
  // Targeting
  targetUserIds   String?        // JSON array of user IDs for targeted promotions
  minOrderAmount  Float?
  
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("promotions")
}

// Notification model
model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title       String
  message     String
  type        String   // e.g., "ORDER_UPDATE", "PROMOTION", "PAYMENT"
  data        String?  // JSON additional data
  
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("notifications")
}

// Settings model (for admin-configurable settings)
model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

// Message type enum
enum MessageType {
  TEXT
  IMAGE
  LOCATION
  QUICK_MESSAGE
  SYSTEM
}

// Conversation model (1 order = 1 conversation)
model Conversation {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // Participants
  clientId    String
  washerId    String?
  
  // Status
  isActive    Boolean  @default(true)    // Can send messages
  isLocked    Boolean  @default(false)   // Read-only after 24h
  
  // Last message preview
  lastMessage String?
  lastMessageAt DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  messages    Message[]
  
  @@map("conversations")
}

// Message model
model Message {
  id             String      @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  // Sender
  senderId       String
  sender         User        @relation("SentMessages", fields: [senderId], references: [id])
  receiverId     String
  receiver       User        @relation("ReceivedMessages", fields: [receiverId], references: [id])
  
  // Content
  type           MessageType @default(TEXT)
  content        String      // Text content or JSON for location/image
  
  // For images
  imageUrl       String?
  
  // For location
  latitude       Float?
  longitude      Float?
  
  // For quick messages
  quickType      String?     // "ARRIVING", "ON_SITE", "DELAY"
  
  // Status
  isRead         Boolean     @default(false)
  readAt         DateTime?
  
  createdAt      DateTime    @default(now())
  
  @@map("messages")
}

// Wallet model (portefeuille électronique)
model Wallet {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  balance         Float    @default(0)    // Solde actuel
  totalDeposited  Float    @default(0)    // Total des rechargements
  totalSpent      Float    @default(0)    // Total des dépenses
  
  isActive        Boolean  @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  transactions    WalletTransaction[]
  
  @@map("wallets")
}

// Wallet Transaction model
model WalletTransaction {
  id              String            @id @default(cuid())
  walletId        String
  wallet          Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  
  type            TransactionType
  amount          Float
  status          TransactionStatus @default(PENDING)
  
  // Reference to order (for payments/refunds)
  orderId         String?
  
  // External payment reference (for deposits)
  externalRef     String?
  phoneNumber     String?           // Phone number used for deposit
  paymentMethod   String?           // "Mixx by Yas", "Flooz", etc.
  
  // USSD confirmation
  ussdCode        String?           // USSD code generated
  ussdConfirmedAt DateTime?         // When user confirmed payment
  
  // Admin validation
  adminNotes      String?           // Notes from admin validation
  
  // Description
  description     String?
  
  // Balance after transaction
  balanceAfter    Float
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  @@map("wallet_transactions")
}

// Mobile Money Operator configuration
model MobileMoneyOperator {
  id              String   @id @default(cuid())
  name            String   @unique // "Mixx by Yas", "Flooz"
  displayName     String   // "Mixx by Yas (Togo Telecom)", "Flooz (Moov Africa)"
  
  // USSD Configuration
  ussdPattern     String   // "*145*1*{montant}*{numero}*2#"
  recipientNumber String   // "90000000" - numéro destinataire pour les paiements
  
  // Display
  logo            String?  // URL du logo
  color           String   // Couleur theme "#FF6600"
  isActive        Boolean  @default(true)
  
  // Validation settings
  minAmount       Float    @default(100)
  maxAmount       Float    @default(500000)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@map("mobile_money_operators")
}

// Subscription Plan (Les 4 forfaits)
model SubscriptionPlan {
  id              String   @id @default(cuid())
  name            String   @unique // "Essentiel", "Confort", "Premium", "Prestige"
  displayName     String   // "Abonnement Essentiel", etc.
  description     String?
  
  // Pricing
  price           Float    // Prix mensuel
  quarterlyPrice  Float?   // Prix trimestriel (avec réduction)
  yearlyPrice     Float?   // Prix annuel (avec réduction)
  
  // Included washes
  washCount       Int      @default(4) // Nombre de lavages inclus
  serviceId       String   // Service associé (Essentiel, Confort, etc.)
  service         Service  @relation(fields: [serviceId], references: [id])
  
  // Benefits
  priority        Int      @default(0) // 0=normal, 1=légère, 2=priorité, 3=maximale
  bonusWashes     Int      @default(0) // Lavages bonus si tous utilisés (Prestige)
  freeOptions     Int      @default(0) // Options gratuites (désodorisation, etc.)
  includesExpress Boolean  @default(false) // Service express inclus
  includesVip     Boolean  @default(false) // Accès VIP
  
  // Features (JSON array of strings)
  features        String?  // JSON: ["Économie mensuelle", "Priorité sur les réservations"]
  
  // Status
  isActive        Boolean  @default(true)
  displayOrder    Int      @default(0) // Ordre d'affichage
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  subscriptions   UserSubscription[]
  
  @@map("subscription_plans")
}

// Subscription Duration type
enum SubscriptionDuration {
  MONTHLY
  QUARTERLY
  YEARLY
}

// User Subscription (Abonnement utilisateur)
model UserSubscription {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId          String
  plan            SubscriptionPlan   @relation(fields: [planId], references: [id])
  
  // Duration and pricing
  duration        SubscriptionDuration @default(MONTHLY)
  paidAmount      Float              // Montant réellement payé
  
  // Wash tracking
  totalWashes     Int                // Total lavages inclus (peut être > 4 pour trimestriel/annuel)
  usedWashes      Int                @default(0) // Lavages utilisés
  remainingWashes Int                // Lavages restants
  
  // Free options tracking
  freeOptionsUsed Int                @default(0) // Options gratuites utilisées
  freeOptionsTotal Int               @default(0) // Total options gratuites
  
  // Bonus wash tracking (Prestige)
  bonusWashEarned Boolean            @default(false) // Lavage bonus gagné
  
  // Dates
  startDate       DateTime           // Date de début
  endDate         DateTime           // Date de fin
  activatedAt     DateTime           @default(now()) // Date d'activation
  
  // Status
  isActive        Boolean            @default(true)
  isExpired       Boolean            @default(false)
  autoRenew       Boolean            @default(false) // Renouvellement automatique
  
  // Payment
  paymentMethod   PaymentMethod      @default(WALLET)
  transactionId   String?            // Référence transaction wallet
  
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  
  // Relations
  usages          SubscriptionUsage[]
  
  @@map("user_subscriptions")
}


// Subscription Usage (Historique d'utilisation)
model SubscriptionUsage {
  id               String   @id @default(cuid())
  subscriptionId   String
  subscription     UserSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  
  // Order reference (one-to-one)
  orderId          String?  @unique
  order            Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  
  // Usage details
  usedAt           DateTime @default(now())
  serviceName      String   // Nom du service au moment de l'utilisation
  washType         String   // "standard" ou "bonus"
  
  // Location
  address          String?
  
  // Validation status
  status           SubscriptionUsageStatus @default(PENDING)
  validatedAt      DateTime?   // When washer validated
  validatedBy      String?     // Washer ID who validated
  
  // Admin can override
  adminNotes       String?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("subscription_usages")
}

// One-time password (OTP) codes for phone verification / login
// Codes are stored hashed, expire after 5 minutes and are never
// returned in API responses (sent by SMS only, or shown in the UI
// when no SMS provider is configured — demo mode).
model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String    // bcrypt hash of the 6-digit code
  expiresAt  DateTime  // creation + 5 minutes
  attempts   Int       @default(0) // failed verification attempts (max 5)
  consumedAt DateTime? // set when the code is successfully verified
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@map("otp_codes")
}

// Washer Withdrawal Status
enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

// Washer Withdrawal (Demande de retrait)
model WasherWithdrawal {
  id              String            @id @default(cuid())
  washerId        String
  washer          Washer            @relation(fields: [washerId], references: [id], onDelete: Cascade)
  
  // Amount
  amount          Float             // Montant demandé
  fee             Float             @default(0) // Frais de retrait
  
  // Payment method
  phoneNumber     String            // Numéro Mobile Money
  operator        String            // "Mixx by Yas", "Flooz"
  
  // Status
  status          WithdrawalStatus  @default(PENDING)
  
  // Admin validation
  adminNotes      String?
  processedBy     String?           // Admin ID
  processedAt     DateTime?
  
  // Transaction reference
  transactionRef  String?           // Référence de la transaction Mobile Money
  
  // Timestamps
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("washer_withdrawals")
