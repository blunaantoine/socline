# ============================================================
# Socline — Service temps réel chat / notifications (port 3003)
# Installation : sudo cp deploy/socline-chat.service /etc/systemd/system/
# ============================================================
[Unit]
Description=Socline - Service socket chat & notifications (port 3003)
After=network.target

[Service]
Type=simple
User=socline
Group=socline
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
Environment=NODE_ENV=production
ExecStart=__BUN_PATH__ __APP_DIR__/mini-services/chat-service/index.ts
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=socline-chat

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
