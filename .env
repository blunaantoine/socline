# --- SMS / OTP configuration ---
# Supported providers: africastalking | twilio | http
# When none is configured, the app runs in SMS demo mode:
# the OTP is NOT sent by SMS and is displayed in the UI (test only).
SMS_PROVIDER=africastalking
SMS_API_KEY=atsk_bb25706e0b2a4221d241cfa8c9a5932be194d25f3b329cff731be6950a13e06d0a38f9c8
# Username confirmé fonctionnel (test réel HTTP 201, SMS reçu le 2026-02-11):
SMS_USERNAME=blunaantoine
# ⚠️ NE PAS définir SMS_SENDER_ID tant qu'un sender ID n'est pas enregistré
# et approuvé sur le dashboard AT (sinon → InvalidSenderId).
# Pour avoir "SOCLINE" comme expéditeur: account.africastalking.com → Settings → Sender IDs
# SMS_SENDER_ID=SOCLINE
# SMS_WEBHOOK_URL=
# Fallback démo: si le provider est configuré mais que l'envoi échoue
# (pas de crédit, numéro non joignable…), le code est affiché dans l'UI
# au lieu de bloquer l'inscription. À mettre sur "false" en production.
SMS_DEMO_FALLBACK=true
