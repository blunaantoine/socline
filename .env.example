# ============================================================
# Socline — variables d'environnement (copier vers .env)
# ============================================================
# Local dev : seul DATABASE_URL est obligatoire.
# Vercel démo : voir VERCEL_DEPLOY.md pour la marche à suivre complète.
# ------------------------------------------------------------
# ATTENTION : ce fichier est un modèle — ne jamais y mettre de vraies clés
# et ne JAMAIS committer le fichier .env réel.

# --- Base de données -----------------------------------------
# Local (SQLite fichier) :
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# --- Database Turso (déploiement Vercel) ----------------------
# Créer une DB gratuite sur https://turso.tech puis :
#   TURSO_DATABASE_URL="libsql://<nom-de-la-db>-<user>.turso.io"
#   TURSO_AUTH_TOKEN="<token créé avec turso db tokens create>"
# Pousser le schéma vers Turso :
#   DATABASE_URL="libsql://...?authToken=..." bunx prisma db push
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# --- Sécurité -------------------------------------------------
# Secret de signature des JWT de session (partagé avec mini-services/chat-service
# et les routes mobile). OBLIGATOIRE sur Vercel : changez-le !
JWT_SECRET="socline-jwt-secret-change-in-production"
JWT_REFRESH_SECRET="socline-jwt-refresh-secret-change-in-production"
# Secret partagé Next.js ↔ chat-service pour POST /internal/emit
INTERNAL_SOCKET_SECRET="socline-internal-secret"

# --- Temps réel (socket.io) -----------------------------------
# Le mini-service socket ne peut PAS tourner sur Vercel (serverless).
# Sur Vercel : NEXT_PUBLIC_ENABLE_SOCKET=false (l'app repasse en polling).
# En local : ne rien définir (activé par défaut).
# NEXT_PUBLIC_ENABLE_SOCKET=false

# --- SMS / OTP (Africa's Talking) — optionnel -----------------
# SMS_PROVIDER=africastalking
# SMS_USERNAME=<username AT>
# SMS_API_KEY=<clé API AT>
# SMS_SENDER_ID=SOCLINE
# "true" : si l'envoi provider échoue, l'OTP est affiché dans la réponse (démo)
SMS_DEMO_FALLBACK="true"
# sms | whatsapp | both
OTP_CHANNEL=sms

# --- WhatsApp OTP (Meta Cloud API) — optionnel ----------------
# WHATSAPP_TOKEN=<token permanent Meta>
# WHATSAPP_PHONE_NUMBER_ID=<id du numéro WhatsApp Business>
# WHATSAPP_OTP_MODE=template
# WHATSAPP_OTP_TEMPLATE=<nom du template approuvé>
# WHATSAPP_OTP_LANG=fr

# --- Firebase Cloud Messaging (push notifications) ------------
# Config web (Console Firebase → Paramètres du projet → Vos applications).
# Ces valeurs sont PUBLIQUES par design (exposées au navigateur).
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# Clé VAPID (Console Firebase → Cloud Messaging → Certificats push web)
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Compte de service (Paramètres du projet → Comptes de service → Générer une
# clé privée JSON). Accepte le JSON brut OU son encodage base64.
# FIREBASE_SERVICE_ACCOUNT=
